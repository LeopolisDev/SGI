{
  "name": "SGI",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterGui": {
      "$ignoreUnknownInstances": true,

      "PlayUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "PlayButton": {
          "$className": "TextButton",
          "$ignoreUnknownInstances": true,
          "$path": "src/client/uicontroller/PlayUI/PlayButton"
        }
      }
    },

    "Workspace": {
      "$ignoreUnknownInstances": true,
      "PrestigeBoard": {
        "$className": "Part",
        "$ignoreUnknownInstances": true,
        "SurfaceGui": {
          "$className": "SurfaceGui",
          "$ignoreUnknownInstances": true,
          "$path": "src/client/uicontroller/SurfaceGuis/PrestigeBoard"
        }
      },
      "RebirthBoard": {
        "$className": "Part",
        "$ignoreUnknownInstances": true,
        "SurfaceGui": {
          "$className": "SurfaceGui",
          "$ignoreUnknownInstances": true,
          "$path": "src/client/uicontroller/SurfaceGuis/RebirthBoard"
        }
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "CharacterManager": {
          "$path": "src/client/character"
        },
        "PlayerScripts": {
          "$path": "src/client/player"
        },
        "ClientInit": {
          "$path": "src/init.client.luau" 
        }
      }
    }
  }
}