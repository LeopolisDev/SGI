{
  "name": "SGI",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterGui": {
      "AdminGUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true
      },

      "AdminToggleGUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true
      },

      "CashUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true
      },

      "PlayUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "PlayButton": {
          "$className": "TextButton",
          "$ignoreUnknownInstances": true,
          "$path": "src/client/uicontroller/PlayUI/PlayButton"
        }
      },

      "PrestigeShopUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true
      },

      "PrestigeUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true
      },

      "RebirthUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true
      },

      "RoundUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true
      },

      "ShopGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true
      }
    },

    "Workspace": {
      "$ignoreUnknownInstances": true,
      "PrestigeBoard": {
        "$className": "Part",
        "$ignoreUnknownInstances": true,
        "SurfaceGui": {
          "$className": "SurfaceGui",
          "$ignoreUnknownInstances": true,
          "$path": "src/client/uicontroller/SurfaceGuis/PrestigeBoard"
        }
      },
      "RebirthBoard": {
        "$className": "Part",
        "$ignoreUnknownInstances": true,
        "SurfaceGui": {
          "$className": "SurfaceGui",
          "$ignoreUnknownInstances": true,
          "$path": "src/client/uicontroller/SurfaceGuis/RebirthBoard"
        }
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client/player",
        "CharacterManager": {
          "$path": "src/client/character"
        },
        "ClientInit": {
          "$path": "src/client/init.client.luau"
        }
      }
    }
  }
}